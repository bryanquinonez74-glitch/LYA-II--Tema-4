<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx/22"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.braynsystem.generadorcodigoobjeto.GCOController">

    <!-- ================================================= -->
    <!-- ENCABEZADO -->
    <!-- ================================================= -->

    <top>

        <VBox
                spacing="5"
                style="-fx-background-color: #111827;">

            <padding>
                <Insets
                        top="20"
                        right="25"
                        bottom="20"
                        left="25"/>
            </padding>

            <Label
                    text="Generador de Código Objeto"
                    style="
                        -fx-font-size: 27px;
                        -fx-font-weight: bold;
                        -fx-text-fill: white;
                    "/>

            <Label
                    text="Lenguajes y Autómatas II"
                    style="
                        -fx-font-size: 14px;
                        -fx-text-fill: #CBD5E1;
                    "/>

        </VBox>

    </top>


    <!-- ================================================= -->
    <!-- MENÚ LATERAL -->
    <!-- ================================================= -->

    <left>

        <VBox
                prefWidth="250"
                spacing="15"
                style="-fx-background-color: #1F2937;">

            <padding>
                <Insets
                        top="25"
                        right="20"
                        bottom="25"
                        left="20"/>
            </padding>



            <!-- ANÁLISIS SEMÁNTICO -->

            <Button
                    text="Análisis Semántico"
                    prefWidth="210"
                    prefHeight="42"
                    onAction="#mostrarAnalisis"
                    style="
                        -fx-background-color: #374151;
                        -fx-text-fill: white;
                        -fx-font-size: 14px;
                        -fx-font-weight: bold;
                        -fx-alignment: CENTER-LEFT;
                        -fx-background-radius: 7px;
                        -fx-cursor: hand;
                    "/>


            <!-- CÓDIGO INTERMEDIO -->

            <Button
                    text="Código Intermedio"
                    prefWidth="210"
                    prefHeight="42"
                    onAction="#mostrarIntermedio"
                    style="
                        -fx-background-color: #374151;
                        -fx-text-fill: white;
                        -fx-font-size: 14px;
                        -fx-font-weight: bold;
                        -fx-alignment: CENTER-LEFT;
                        -fx-background-radius: 7px;
                        -fx-cursor: hand;
                    "/>


            <!-- REGISTROS -->

            <Button
                    text="Registros"
                    prefWidth="210"
                    prefHeight="42"
                    onAction="#mostrarRegistros"
                    style="
                        -fx-background-color: #374151;
                        -fx-text-fill: white;
                        -fx-font-size: 14px;
                        -fx-font-weight: bold;
                        -fx-alignment: CENTER-LEFT;
                        -fx-background-radius: 7px;
                        -fx-cursor: hand;
                    "/>


            <!-- ENSAMBLADOR -->

            <Button
                    text="Lenguaje Ensamblador"
                    prefWidth="210"
                    prefHeight="42"
                    onAction="#mostrarEnsamblador"
                    style="
                        -fx-background-color: #374151;
                        -fx-text-fill: white;
                        -fx-font-size: 13px;
                        -fx-font-weight: bold;
                        -fx-alignment: CENTER-LEFT;
                        -fx-background-radius: 7px;
                        -fx-cursor: hand;
                    "/>


            <!-- CÓDIGO MÁQUINA -->

            <Button
                    text="Lenguaje Máquina"
                    prefWidth="210"
                    prefHeight="42"
                    onAction="#mostrarMaquina"
                    style="
                        -fx-background-color: #374151;
                        -fx-text-fill: white;
                        -fx-font-size: 13px;
                        -fx-font-weight: bold;
                        -fx-alignment: CENTER-LEFT;
                        -fx-background-radius: 7px;
                        -fx-cursor: hand;
                    "/>


            <!-- MEMORIA -->

            <Button
                    text="Administración de Memoria"
                    prefWidth="210"
                    prefHeight="42"
                    onAction="#mostrarMemoria"
                    style="
                        -fx-background-color: #374151;
                        -fx-text-fill: white;
                        -fx-font-size: 12px;
                        -fx-font-weight: bold;
                        -fx-alignment: CENTER-LEFT;
                        -fx-background-radius: 7px;
                        -fx-cursor: hand;
                    "/>


            <!-- TABLA DE SÍMBOLOS -->

            <Button
                    text="Tabla de Símbolos"
                    prefWidth="210"
                    prefHeight="42"
                    onAction="#mostrarSimbolos"
                    style="
                        -fx-background-color: #374151;
                        -fx-text-fill: white;
                        -fx-font-size: 13px;
                        -fx-font-weight: bold;
                        -fx-alignment: CENTER-LEFT;
                        -fx-background-radius: 7px;
                        -fx-cursor: hand;
                    "/>


            <Region
                    VBox.vgrow="ALWAYS"/>


            <Label
                    text="Proyecto de Lenguajes y Autómatas II"
                    wrapText="true"
                    style="
                        -fx-font-size: 12px;
                        -fx-text-fill: #94A3B8;
                    "/>

        </VBox>

    </left>


    <!-- ================================================= -->
    <!-- CONTENIDO CENTRAL -->
    <!-- ================================================= -->

    <center>

        <StackPane
                fx:id="contenedor"
                style="-fx-background-color: #F3F4F6;">

            <VBox
                    alignment="CENTER"
                    spacing="12">

                <Label
                        text="Generador de Código Objeto"
                        style="
                            -fx-font-size: 28px;
                            -fx-font-weight: bold;
                            -fx-text-fill: #1F2937;
                        "/>

                <Label
                        text="Sistema de análisis y generación de código"
                        style="
                            -fx-font-size: 15px;
                            -fx-text-fill: #6B7280;
                        "/>

                <Label
                        text="Seleccione una opción del menú para comenzar"
                        style="
                            -fx-font-size: 13px;
                            -fx-text-fill: #9CA3AF;
                        "/>

            </VBox>

        </StackPane>

    </center>

</BorderPane>