<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.braynsystem.generadorcodigoobjeto.controller.IntermedioController"
        spacing="15"
        style="-fx-background-color: #F3F4F6;">

    <padding>
        <Insets
                top="30"
                right="30"
                bottom="30"
                left="30"/>
    </padding>

    <Label
            text="Generación de Código Intermedio"
            style="
                -fx-font-size: 26px;
                -fx-font-weight: bold;
                -fx-text-fill: #1F2937;
            "/>

    <Label
            text="Introduzca el código fuente para generar las instrucciones intermedias."
            style="
                -fx-font-size: 14px;
                -fx-text-fill: #6B7280;
            "/>

    <Label
            text="Código fuente"
            style="
                -fx-font-size: 15px;
                -fx-font-weight: bold;
                -fx-text-fill: #374151;
            "/>

    <TextArea
            fx:id="txtCodigoFuente"
            prefHeight="180"
            promptText="Ejemplo:
int a = 10;
int b = 20;
int c = a + b;"
            style="
                -fx-font-family: monospace;
                -fx-font-size: 14px;
            "/>

    <!-- BOTONES -->

    <HBox spacing="10">

        <Button
                text="Generar Código Intermedio"
                onAction="#generarIntermedio"
                prefWidth="230"
                prefHeight="40"
                style="
                    -fx-background-color: #2563EB;
                    -fx-text-fill: white;
                    -fx-font-weight: bold;
                    -fx-background-radius: 7px;
                    -fx-cursor: hand;
                "/>

        <Button
                text="Limpiar"
                onAction="#limpiar"
                prefWidth="120"
                prefHeight="40"
                style="
                    -fx-background-color: #DC2626;
                    -fx-text-fill: white;
                    -fx-font-weight: bold;
                    -fx-background-radius: 7px;
                    -fx-cursor: hand;
                "/>

    </HBox>

    <Label
            text="Código intermedio generado"
            style="
                -fx-font-size: 15px;
                -fx-font-weight: bold;
                -fx-text-fill: #374151;
            "/>

    <TextArea
            fx:id="txtCodigoIntermedio"
            prefHeight="200"
            editable="false"
            style="
                -fx-font-family: monospace;
                -fx-font-size: 14px;
            "/>

</VBox>