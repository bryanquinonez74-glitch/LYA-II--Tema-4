<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.VBox?>

<VBox
        xmlns="http://javafx.com/javafx/22"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.braynsystem.generadorcodigoobjeto.controller.RegistrosController"
        spacing="15"
        style="-fx-background-color: #F3F4F6;">

    <padding>
        <Insets top="25" right="35" bottom="25" left="35"/>
    </padding>

    <Label
            text="Asignación de Registros"
            style="
                -fx-font-size: 28px;
                -fx-font-weight: bold;
                -fx-text-fill: #1F2937;
            "/>

    <Label
            text="Administración y asignación de variables a registros del procesador."
            style="
                -fx-font-size: 14px;
                -fx-text-fill: #6B7280;
            "/>

    <Button
            text="Asignar registros"
            onAction="#asignarRegistros"
            prefWidth="180"
            prefHeight="40"
            style="
                -fx-background-color: #2563EB;
                -fx-text-fill: white;
                -fx-font-weight: bold;
                -fx-background-radius: 7px;
            "/>

    <TableView
            fx:id="tablaRegistros"
            prefHeight="350">

        <columns>

            <TableColumn
                    text="Registro"
                    prefWidth="150">

                <cellValueFactory>
                    <PropertyValueFactory property="nombre"/>
                </cellValueFactory>

            </TableColumn>

            <TableColumn
                    text="Valor"
                    prefWidth="200">

                <cellValueFactory>
                    <PropertyValueFactory property="valor"/>
                </cellValueFactory>

            </TableColumn>

            <TableColumn
                    text="Estado"
                    prefWidth="180">

                <cellValueFactory>
                    <PropertyValueFactory property="ocupado"/>
                </cellValueFactory>

            </TableColumn>

        </columns>

    </TableView>

</VBox>