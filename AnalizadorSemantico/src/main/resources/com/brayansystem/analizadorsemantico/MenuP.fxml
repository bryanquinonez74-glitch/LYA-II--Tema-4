<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.brayansystem.analizadorsemantico.controller.AnalizadorSController">

    <top>
        <VBox spacing="8">

            <padding>
                <Insets top="15"
                        right="20"
                        bottom="15"
                        left="20"/>
            </padding>

            <Label text="ANALIZADOR SEMÁNTICO"
                   style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

            <Label text="Lenguajes y Autómatas II"
                   style="-fx-font-size: 14px;"/>

            <Separator/>

        </VBox>
    </top>

    <center>

        <HBox spacing="15">

            <padding>
                <Insets top="10"
                        right="20"
                        bottom="10"
                        left="20"/>
            </padding>

            <VBox spacing="8"
                  HBox.hgrow="ALWAYS">

                <Label text="Código fuente"
                       style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

                <TextArea fx:id="txtCodigo"
                          promptText="Escribe aquí el código que deseas analizar..."
                          wrapText="false"
                          VBox.vgrow="ALWAYS"/>

            </VBox>

            <VBox spacing="10"
                  HBox.hgrow="ALWAYS">

                <Label text="Análisis léxico"
                       style="-fx-font-size: 16px; -fx-font-weight: bold;"/>


                <TableView fx:id="tablaTokens"
                           prefHeight="230"
                           VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="colLexema"
                                     text="Lexema"
                                     prefWidth="140"/>

                        <TableColumn fx:id="colTipo"
                                     text="Tipo"
                                     prefWidth="145"/>

                        <TableColumn fx:id="colLinea"
                                     text="Línea"
                                     prefWidth="65"/>

                        <TableColumn fx:id="colColumna"
                                     text="Columna"
                                     prefWidth="75"/>

                    </columns>

                </TableView>

                <Label text="Tabla de símbolos"
                       style="-fx-font-size: 16px; -fx-font-weight: bold;"/>


                <TableView fx:id="tablaSimbolos"
                           prefHeight="180"
                           VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="colNombreSimbolo"
                                     text="Nombre"
                                     prefWidth="120"/>

                        <TableColumn fx:id="colTipoSimbolo"
                                     text="Tipo"
                                     prefWidth="100"/>

                        <TableColumn fx:id="colValorSimbolo"
                                     text="Valor"
                                     prefWidth="130"/>

                        <TableColumn fx:id="colLineaSimbolo"
                                     text="Línea"
                                     prefWidth="65"/>

                    </columns>

                </TableView>
                <Label text="Resultado del análisis"
                       style="-fx-font-size: 16px; -fx-font-weight: bold;"/>


                <TextArea fx:id="txtResultado"
                          editable="false"
                          wrapText="true"
                          promptText="Aquí aparecerán los resultados del análisis sintáctico y semántico..."
                          prefHeight="150"
                          VBox.vgrow="ALWAYS"/>

            </VBox>

        </HBox>

    </center>

    <bottom>

        <VBox spacing="10">

            <padding>
                <Insets top="10"
                        right="20"
                        bottom="20"
                        left="20"/>
            </padding>

            <Separator/>


            <HBox spacing="10">

                <Button fx:id="btnAnalizar"
                        text="Analizar"
                        prefWidth="120"
                        onAction="#analizarCodigo"/>

                <Button fx:id="btnLimpiar"
                        text="Limpiar"
                        prefWidth="120"
                        onAction="#limpiar"/>

            </HBox>

        </VBox>

    </bottom>

</BorderPane>